#version 460
// A/B difference: |A - B| of the two techniques' HDR outputs after exposure, scaled and shown in false colour
// (black: the same; blue, green, yellow, red: more and more different). As rimgui_difference.frag.
#include "rimgui_vk.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Constants { uint a; uint b; uint target; ivec2 size; float exposure; float scale; } pc;

vec3 heat(float t)
{
    t = clamp(t, 0.0, 1.0);
    vec3 c = mix(vec3(0.0), vec3(0.1, 0.2, 0.9), smoothstep(0.0, 0.25, t));
    c = mix(c, vec3(0.1, 0.8, 0.3), smoothstep(0.25, 0.5, t));
    c = mix(c, vec3(1.0, 0.9, 0.1), smoothstep(0.5, 0.75, t));
    return mix(c, vec3(1.0, 0.15, 0.1), smoothstep(0.75, 1.0, t));
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;
    vec3 a = fetch_2d(pc.a, p).rgb * pc.exposure, b = fetch_2d(pc.b, p).rgb * pc.exposure;
    // Compared after a simple tone curve, so bright and dark areas weigh as the eye sees them.
    vec3 d = abs(a / (1.0 + a) - b / (1.0 + b));
    imageStore(u_images[pc.target], p, vec4(heat(max(d.r, max(d.g, d.b)) * pc.scale), 1.0));
}
