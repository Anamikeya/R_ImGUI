#version 460
// Linear HDR to the display: exposure, a tone curve, then sRGB's gamma; NaN and infinite pixels show magenta. As
// rimgui_tonemap.frag.
#include "rimgui_vk.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Constants { uint hdr; uint target; ivec2 size; float exposure; int mode; } pc;

vec3 aces(vec3 x) { return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0); }
vec3 to_srgb(vec3 c) { return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c)); }

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;
    vec3 raw = fetch_2d(pc.hdr, p).rgb;
    // NaN and infinity are bugs in a technique: shown magenta, never hidden as black.
    if (any(isnan(raw)) || any(isinf(raw))) {
        imageStore(u_images[pc.target], p, vec4(1.0, 0.0, 1.0, 1.0));
        return;
    }
    vec3 c = max(raw * pc.exposure, vec3(0.0));
    if (pc.mode == 0) c = aces(c);
    else if (pc.mode == 1) c = c / (1.0 + c);
    else c = clamp(c, 0.0, 1.0);
    imageStore(u_images[pc.target], p, vec4(to_srgb(c), 1.0));
}
