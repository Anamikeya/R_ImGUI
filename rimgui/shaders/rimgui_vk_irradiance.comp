#version 460
// Diffuse light round every normal: the cosine-weighted integral of the environment over the hemisphere, divided by
// pi, for one face. As rimgui_irradiance.frag.
#include "rimgui_vk.glsl"
#include "rimgui_vk_cube.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Constants { uint source; uint target; int size; int face; float source_size; float roughness; } pc;

void main()
{
    ivec2 texel;
    vec2 uv;
    if (!face_texel(pc.size, texel, uv)) return;
    vec3 n = cube_direction(pc.face, uv);
    vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 t = normalize(cross(up, n));
    vec3 b = cross(n, t);
    // Each sample covers about (2 pi / 64) x (pi / 2 / 16) of the sphere: a mip level that wide, so small bright spots
    // are not missed between samples.
    float texel_angle = 4.0 * 3.14159265359 / (6.0 * pc.source_size * pc.source_size);
    float sample_angle = (6.28318530718 / 64.0) * (1.5707963 / 16.0);
    float level = max(0.5 * log2(sample_angle / texel_angle) + 1.0, 0.0);
    vec3 sum = vec3(0.0);
    float count = 0.0;
    for (int i = 0; i < 64; ++i) {
        float phi = (float(i) + 0.5) / 64.0 * 6.28318530718;
        for (int j = 0; j < 16; ++j) {
            float theta = (float(j) + 0.5) / 16.0 * 1.5707963;
            vec3 local = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
            vec3 d = t * local.x + b * local.y + n * local.z;
            sum += sample_cube(pc.source, d, level).rgb * cos(theta) * sin(theta);
            count += 1.0;
        }
    }
    imageStore(u_images[pc.target], texel, vec4(3.14159265359 * sum / count, 1.0));
}
