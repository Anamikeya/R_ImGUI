#version 460
// The split sum's BRDF half (Karis 2013) into an RG16F table: for NoV (u) and roughness (v), the scale and bias to
// apply to F0 under uniform white light, with height-correlated Smith visibility. As rimgui_brdf_lut.frag.
#include "rimgui_vk.glsl"
#include "rimgui_vk_cube.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Constants { uint target; int size; } pc;

float V_SmithGGXCorrelated_lut(float NoV, float NoL, float a)
{
    float a2 = a * a;
    float ggx_v = NoL * sqrt(NoV * NoV * (1.0 - a2) + a2);
    float ggx_l = NoV * sqrt(NoL * NoL * (1.0 - a2) + a2);
    return 0.5 / max(ggx_v + ggx_l, 1e-6);
}

void main()
{
    ivec2 texel;
    vec2 uv;
    if (!face_texel(pc.size, texel, uv)) return;
    float NoV = max(uv.x, 1e-3);
    float roughness = uv.y;
    float a = max(roughness * roughness, 1e-3);
    vec3 v = vec3(sqrt(1.0 - NoV * NoV), 0.0, NoV);
    vec3 n = vec3(0.0, 0.0, 1.0);
    const uint count = 512u;
    float scale = 0.0, bias = 0.0;
    for (uint i = 0u; i < count; ++i) {
        vec3 h = importance_sample_ggx(hammersley(i, count), n, a);
        vec3 l = normalize(2.0 * dot(v, h) * h - v);
        float NoL = clamp(l.z, 0.0, 1.0);
        float NoH = clamp(h.z, 0.0, 1.0);
        float VoH = clamp(dot(v, h), 0.0, 1.0);
        if (NoL > 0.0) {
            float vis = V_SmithGGXCorrelated_lut(NoV, NoL, a) * 4.0 * NoL * VoH / max(NoH, 1e-4);
            float fc = pow(1.0 - VoH, 5.0);
            scale += (1.0 - fc) * vis;
            bias += fc * vis;
        }
    }
    imageStore(u_images[pc.target], texel, vec4(vec2(scale, bias) / float(count), 0.0, 1.0));
}
