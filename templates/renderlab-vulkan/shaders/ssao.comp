#version 460
// Screen-space ambient occlusion: a hemisphere of samples round each pixel's normal, in view space, each tested against
// the depth buffer, with a range check so far-off surfaces do not darken edges. The OpenGL lab's ssao.frag as a
// compute shader.
#include "rimgui_vk_scene.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Constants {
    FrameData frame;
    uint depth;  // G-buffer depth
    uint normal; // G-buffer view-space normal
    uint target; // R16F storage image
    ivec2 size;
    float radius, bias, strength;
    int samples;
} pc;

vec3 view_position(vec2 uv)
{
    float depth = sample_2d_lod(pc.depth, uv, 0.0).r;
    vec4 p = pc.frame.inverse_projection * vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    return p.xyz / p.w;
}

// Interleaved gradient noise (Jimenez 2014): a per-pixel angle that a small blur removes.
float ign(vec2 pixel) { return fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715)))); }
float hash(float n) { return fract(sin(n) * 43758.5453); }

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.size.x || pixel.y >= pc.size.y) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.size);
    float depth = fetch_2d(pc.depth, pixel).r;
    if (depth >= 1.0) {
        imageStore(u_images[pc.target], pixel, vec4(1.0));
        return;
    }
    vec3 p = view_position(uv);
    vec3 n = normalize(fetch_2d(pc.normal, pixel).xyz);
    float angle = ign(vec2(pixel) + 0.5) * 6.2831853;
    vec3 random = vec3(cos(angle), sin(angle), 0.0);
    vec3 t = normalize(random - n * dot(random, n));
    mat3 tbn = mat3(t, cross(n, t), n);
    float occlusion = 0.0;
    for (int i = 0; i < pc.samples; ++i) {
        float fi = float(i);
        // A point in the unit hemisphere, more of them near the centre.
        vec3 s = normalize(vec3(hash(fi * 3.1 + 0.1) * 2.0 - 1.0, hash(fi * 7.7 + 0.2) * 2.0 - 1.0, hash(fi * 1.3 + 0.3)));
        float scale = (fi + 1.0) / float(pc.samples);
        s *= hash(fi * 5.3 + 0.4) * mix(0.1, 1.0, scale * scale);
        vec3 sample_point = p + tbn * s * pc.radius;
        vec4 clip = pc.frame.projection * vec4(sample_point, 1.0);
        vec2 sample_uv = clip.xy / clip.w * 0.5 + 0.5;
        float scene_z = view_position(sample_uv).z;
        float in_range = smoothstep(0.0, 1.0, pc.radius / max(abs(p.z - scene_z), 1e-4));
        occlusion += (scene_z >= sample_point.z + pc.bias ? 1.0 : 0.0) * in_range;
    }
    float ao = pow(clamp(1.0 - occlusion / float(pc.samples), 0.0, 1.0), pc.strength);
    imageStore(u_images[pc.target], pixel, vec4(ao));
}
