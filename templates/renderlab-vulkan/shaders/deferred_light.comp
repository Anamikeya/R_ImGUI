#version 460
// The deferred lighting pass, as a compute shader writing the output: every pixel lit from the G-buffer with the sun
// and image-based lighting, ambient occlusion from both the material and SSAO. Pixels with nothing in them are left
// black for the sky pass.
#include "rimgui_vk_lighting.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Constants {
    FrameData frame;
    uint albedo, normal, emissive, depth, ao; // G-buffer and SSAO, sampled
    uint target;                              // The output's colour, as a storage image
    ivec2 size;
    int use_ao, ao_only;
} pc;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.size.x || pixel.y >= pc.size.y) return;
    FrameData f = pc.frame;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.size);
    float depth = fetch_2d(pc.depth, pixel).r;
    float ao = pc.use_ao == 1 ? fetch_2d(pc.ao, pixel).r : 1.0;
    if (pc.ao_only == 1) {
        imageStore(u_images[pc.target], pixel, vec4(vec3(ao), 1.0));
        return;
    }
    if (depth >= 1.0) {
        imageStore(u_images[pc.target], pixel, vec4(0.0));
        return;
    }
    vec4 world4 = f.inverse_view_projection * vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec3 world = world4.xyz / world4.w;
    vec4 ar = fetch_2d(pc.albedo, pixel), nm = fetch_2d(pc.normal, pixel), eo = fetch_2d(pc.emissive, pixel);
    vec3 albedo = ar.rgb;
    float roughness = ar.a, metallic = nm.a;
    vec3 n = normalize(transpose(mat3(f.view)) * nm.xyz); // View space back to world (the view is a rotation).
    vec3 v = normalize(f.camera_position - world);
    vec3 diffuse, specular;
    brdf(n, v, f.sun_direction, albedo, roughness, metallic, diffuse, specular);
    vec3 ambient = ambient_light(f, n, v, albedo, roughness, metallic, ao * eo.a);
    imageStore(u_images[pc.target], pixel, vec4((diffuse + specular) * f.sun_color + ambient + eo.rgb, 1.0));
}
