#version 460
// Ray-traced sun shadows and ambient occlusion from the G-buffer, by ray queries in a compute shader: a shadow ray to
// a point on the sun's disc (soft shadows from its angular size), and cosine-distributed occlusion rays of a set length.
// Frames are averaged while nothing changes, so a few rays a pixel converge.
#extension GL_EXT_ray_query : require
#define RIMGUI_RAY_QUERY
#include "rimgui_vk_raytracing.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Constants {
    FrameData frame;
    uint depth, normal;       // G-buffer, sampled
    uint shadow, ao;          // R16F storage images written here
    uint history;             // RG32F storage image: shadow and AO averaged over frames
    ivec2 size;
    float sun_angle;          // The sun's angular radius, radians
    float ao_radius;
    int ao_rays;
    int shadows_on, ao_on;
    int restart;
} pc;

// True when nothing is hit between `origin` and `distance` along `dir`; masked and blended materials by their alpha.
bool unoccluded(vec3 origin, vec3 dir, float distance, inout uint rng)
{
    rayQueryEXT q;
    rayQueryInitializeEXT(q, u_scene, gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, origin, 0.0, dir, distance);
    while (rayQueryProceedEXT(q)) {
        if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            uint object = rayQueryGetIntersectionInstanceCustomIndexEXT(q, false);
            uint primitive = rayQueryGetIntersectionPrimitiveIndexEXT(q, false);
            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(q, false);
            if (alpha_passes(pc.frame, object, primitive, bary, random01(rng))) rayQueryConfirmIntersectionEXT(q);
        }
    }
    return rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.size.x || pixel.y >= pc.size.y) return;
    FrameData f = pc.frame;
    float depth = fetch_2d(pc.depth, pixel).r;
    if (depth >= 1.0) {
        imageStore(u_images[pc.shadow], pixel, vec4(1.0));
        imageStore(u_images[pc.ao], pixel, vec4(1.0));
        return;
    }
    uint rng = seed_for(uvec2(pixel), uint(f.accumulation) * 7u + uint(f.frame_index));
    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.size);
    vec4 world4 = f.inverse_view_projection * vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec3 world = world4.xyz / world4.w;
    vec3 n = normalize(transpose(mat3(f.view)) * fetch_2d(pc.normal, pixel).xyz);
    vec3 origin = offset_origin(world, n) + n * 1e-3;

    float lit = 1.0;
    if (pc.shadows_on == 1) {
        lit = 0.0;
        if (dot(n, f.sun_direction) > 0.0) {
            // A direction in the sun's cone.
            vec3 up = abs(f.sun_direction.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
            vec3 t = normalize(cross(up, f.sun_direction)), b = cross(f.sun_direction, t);
            float r = sqrt(random01(rng)) * tan(pc.sun_angle), phi = 6.28318530718 * random01(rng);
            vec3 dir = normalize(f.sun_direction + (t * cos(phi) + b * sin(phi)) * r);
            lit = unoccluded(origin, dir, 1e30, rng) ? 1.0 : 0.0;
        }
    }
    float open = 1.0;
    if (pc.ao_on == 1 && pc.ao_rays > 0) {
        float count = 0.0;
        for (int i = 0; i < pc.ao_rays; ++i) {
            vec3 dir = sample_cosine(n, vec2(random01(rng), random01(rng)));
            count += unoccluded(origin, dir, pc.ao_radius, rng) ? 1.0 : 0.0;
        }
        open = count / float(pc.ao_rays);
    }
    // The running average over the frames since anything changed.
    vec4 previous = imageLoad(u_images[pc.history], pixel);
    float k = pc.restart == 1 ? 1.0 : 1.0 / (float(f.accumulation) + 1.0);
    vec2 averaged = mix(previous.xy, vec2(lit, open), k);
    imageStore(u_images[pc.history], pixel, vec4(averaged, 0.0, 1.0));
    imageStore(u_images[pc.shadow], pixel, vec4(averaged.x));
    imageStore(u_images[pc.ao], pixel, vec4(averaged.y));
}
