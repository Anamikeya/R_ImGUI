#version 430 core
// The SSAO blur as a compute shader (OpenGL 4.3): each 8x8 group reads a 4x4 box per pixel and writes the image.
// The same result as ssao_blur.frag; here to show compute in the lab (Timings shows both).
layout(local_size_x = 8, local_size_y = 8) in;
layout(r16f, binding = 0) uniform writeonly image2D u_out;
uniform sampler2D u_ao;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_out);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    vec2 texel = 1.0 / vec2(size);
    vec2 uv = (vec2(pixel) + 0.5) * texel;
    float sum = 0.0;
    for (int y = -2; y < 2; ++y) {
        for (int x = -2; x < 2; ++x) {
            sum += texture(u_ao, uv + (vec2(x, y) + 0.5) * texel).r;
        }
    }
    imageStore(u_out, pixel, vec4(sum / 16.0));
}
